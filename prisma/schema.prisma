generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskType {
  TASK
  MEAL
  MEDICATION
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      Status     @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  recurrence  Recurrence @default(NONE)
  taskType    TaskType   @default(TASK)
  mealType    MealType?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  TaskCategory[]
  subtasks    Subtask[]
  taskFoods   TaskFood[]
  taskMeds    TaskMedication[]
  nutritionLogs NutritionLog[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([taskType])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now())
  tasks     TaskCategory[]
}

model TaskCategory {
  taskId     String
  categoryId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
}

model AppSettings {
  key   String @id
  value String
}

model UserSettings {
  userId              String  @id
  theme               String  @default("light")
  emailNotifications  Boolean @default(false)
  browserNotifications Boolean @default(false)
}

// ── Pairwise Ranking System ────────────────────────────

enum ComparisonResult {
  LEFT
  RIGHT
  TIE
  SKIP
}

model RankingCategory {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6B7280")
  createdAt   DateTime @default(now())
  items       RankingItem[]
  comparisons Comparison[]
}

model RankingItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String   @default("")
  tags        String   @default("")
  elo         Float    @default(1500)
  wins        Int      @default(0)
  losses      Int      @default(0)
  ties        Int      @default(0)
  categoryId  String
  category    RankingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  comparisonsAsLeft  Comparison[] @relation("LeftItem")
  comparisonsAsRight Comparison[] @relation("RightItem")

  @@index([categoryId])
  @@index([elo(sort: Desc)])
}

model Comparison {
  id          String           @id @default(cuid())
  leftItemId  String
  rightItemId String
  result      ComparisonResult
  leftItem    RankingItem      @relation("LeftItem", fields: [leftItemId], references: [id], onDelete: Cascade)
  rightItem   RankingItem      @relation("RightItem", fields: [rightItemId], references: [id], onDelete: Cascade)
  categoryId  String
  category    RankingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([categoryId])
  @@index([leftItemId])
  @@index([rightItemId])
}

// ── Diet & Nutrition Tracking ─────────────────────────

model FoodItem {
  id           String   @id @default(cuid())
  name         String
  brand        String   @default("")
  servingSize  Float    @default(100)
  servingUnit  String   @default("g")
  // Macros (per serving)
  calories     Float    @default(0)
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  fiber        Float    @default(0)
  sugar        Float    @default(0)
  sodium       Float    @default(0)
  // Micros (per serving)
  vitaminA     Float    @default(0)
  vitaminC     Float    @default(0)
  vitaminD     Float    @default(0)
  calcium      Float    @default(0)
  iron         Float    @default(0)
  potassium    Float    @default(0)
  // Source
  externalId   String   @default("")
  source       String   @default("")
  createdAt    DateTime @default(now())
  taskFoods    TaskFood[]
}

model TaskFood {
  id         String   @id @default(cuid())
  taskId     String
  foodItemId String
  quantity   Float    @default(1)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([foodItemId])
}

model NutritionLog {
  id        String   @id @default(cuid())
  date      DateTime
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  sugar     Float    @default(0)
  sodium    Float    @default(0)
  vitaminA  Float    @default(0)
  vitaminC  Float    @default(0)
  vitaminD  Float    @default(0)
  calcium   Float    @default(0)
  iron      Float    @default(0)
  potassium Float    @default(0)
  createdAt DateTime @default(now())

  @@index([date])
  @@index([taskId])
}

// ── Medication Tracking ───────────────────────────────

model MedicationItem {
  id           String   @id @default(cuid())
  name         String
  genericName  String   @default("")
  dosageForm   String   @default("")
  strength     String   @default("")
  description  String   @default("")
  externalId   String   @default("")
  source       String   @default("")
  createdAt    DateTime @default(now())
  taskMeds     TaskMedication[]
}

model TaskMedication {
  id               String         @id @default(cuid())
  taskId           String
  medicationItemId String
  dosage           String         @default("")
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  medicationItem   MedicationItem @relation(fields: [medicationItemId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([medicationItemId])
}

// ── Body Metrics ──────────────────────────────────────

enum MetricType {
  WEIGHT
  BODY_FAT
  HEIGHT
  WAIST
  CHEST
  BMI
}

model BodyMetric {
  id        String     @id @default(cuid())
  date      DateTime
  type      MetricType
  value     Float
  unit      String     @default("")
  createdAt DateTime   @default(now())

  @@index([date])
  @@index([type])
}
