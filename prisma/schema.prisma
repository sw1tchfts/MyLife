generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      Status     @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  recurrence  Recurrence @default(NONE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  TaskCategory[]
  subtasks    Subtask[]
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now())
  tasks     TaskCategory[]
}

model TaskCategory {
  taskId     String
  categoryId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
}

model AppSettings {
  key   String @id
  value String
}

model UserSettings {
  userId              String  @id
  theme               String  @default("light")
  emailNotifications  Boolean @default(false)
  browserNotifications Boolean @default(false)
}

// ── Pairwise Ranking System ────────────────────────────

enum ComparisonResult {
  LEFT
  RIGHT
  TIE
  SKIP
}

model RankingCategory {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6B7280")
  createdAt   DateTime @default(now())
  items       RankingItem[]
  comparisons Comparison[]
}

model RankingItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String   @default("")
  tags        String   @default("")
  elo         Float    @default(1500)
  wins        Int      @default(0)
  losses      Int      @default(0)
  ties        Int      @default(0)
  categoryId  String
  category    RankingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  comparisonsAsLeft  Comparison[] @relation("LeftItem")
  comparisonsAsRight Comparison[] @relation("RightItem")
}

model Comparison {
  id          String           @id @default(cuid())
  leftItemId  String
  rightItemId String
  result      ComparisonResult
  leftItem    RankingItem      @relation("LeftItem", fields: [leftItemId], references: [id], onDelete: Cascade)
  rightItem   RankingItem      @relation("RightItem", fields: [rightItemId], references: [id], onDelete: Cascade)
  categoryId  String
  category    RankingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
}
